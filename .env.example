# comfy-colab-kit — environment template for the VPS gate (comfy-gate).
# Copy to .env and fill in. .env is git-ignored. Secrets are NEVER put here:
# every secret is a *_FILE path pointing at a 0600 file mounted from ./secrets/.
# The hostnames below are examples; replace them with your own.

# ───────────────────────────── Hostnames ─────────────────────────────
PUBLIC_HOST=comfy.example.com           # what you open on your phone (Cloudflare proxied → VPS Caddy → gate)
COLAB_TUNNEL_HOST=comfy-colab.example.com  # cloudflared tunnel hostname that lands on ComfyUI :8188 inside Colab

# ───────────────────────── Cloudflare Access ─────────────────────────
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                              # "Application Audience (AUD) Tag" of the PUBLIC_HOST Access app
ALLOWED_EMAILS=you@example.com              # second check after Access (comma separated)
OWNER_EMAILS=you@example.com                # owners; empty = every signed-in user is an owner
OWNER_ONLY_ACTIONS=switch,stop,extend       # any of wake,switch,stop,extend
CF_SERVICE_TOKEN_FILE=/run/secrets/cf_service.json   # {"client_id": "...", "client_secret": "..."} for COLAB_TUNNEL_HOST
# AUTH_DISABLED=false                       # true ONLY for local development without Cloudflare

# ─────────────────────────────── Colab ───────────────────────────────
COLAB_BIN=colab
COLAB_TOKEN_DIR=/data/colab-cli             # colab CLI OAuth state (written once by `colab` login inside the container)
COLAB_ACCELERATOR=L4
COLAB_SESSION_NAME=comfy

# ────────────────────────────── Profiles ─────────────────────────────
PROFILES=examples/profiles/moss-image,examples/profiles/sd-latest,examples/profiles/qwen-image
DEFAULT_PROFILE=moss-image
DEFAULT_VIEW=app                            # app | graph — what ComfyUI opens in once ready

# ─────────────── Secrets forwarded to Colab (kernel memory only) ───────────────
CF_TUNNEL_TOKEN_FILE=/run/secrets/colab_tunnel_token
HF_TOKEN_FILE=                              # optional read-only HF token (gated repos / rate limits)

# ───────────────────────────── Cold start ────────────────────────────
FAST_START=true                             # start ComfyUI once core models are in, keep downloading the rest
DOWNLOAD_CONCURRENCY=8

# ───────────────────────────── Auto-stop ─────────────────────────────
WAKE_ON_VISIT=false                         # true = opening the page wakes it (HF Space behaviour)
IDLE_TIMEOUT_MIN=30                         # no HTTP/ws activity and empty queue → sleep (0 = off)
MAX_SESSION_HOURS=6
EXTEND_MAX_TIMES=1
EXTEND_HOURS=1
WARN_BEFORE_MIN=10
BOOT_TIMEOUT_MIN=40
STOP_ON_PAGE_CLOSE_MIN=0                    # all tabs closed for N min → sleep (0 = off)
QUIET_HOURS=                                # e.g. 01:00-08:00 (no wake; running sessions stop)
DAILY_CU_BUDGET=12
MONTHLY_CU_BUDGET=150
MIN_CU_BALANCE=5
CU_PER_HOUR=1.71                            # L4 estimate used for the local ledger
ORPHAN_SWEEP_MIN=5
WATCHDOG_GATE_LOST_MIN=20                   # Colab side: no gate heartbeat for N min → VM releases itself

# ─────────────────────────── Agents & runtime ────────────────────────
AGENT_TOKEN_FILE=/run/secrets/agent_token   # `openssl rand -hex 32 > secrets/agent_token`
LISTEN_ADDR=0.0.0.0:8080
STATE_DIR=/data/state
LOG_LEVEL=info
TZ=Asia/Shanghai
