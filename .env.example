# comfy-colab-kit — environment template for the VPS gate (comfy-gate).
# Copy to .env and fill in. .env is git-ignored. Secrets are NEVER put here:
# every secret is a *_FILE path pointing at a 0600 file mounted from ./secrets/.
# The hostnames below are examples; replace them with your own.

# ───────────────────────────── Hostnames ─────────────────────────────
# what you open on your phone (Cloudflare proxied → VPS Caddy → gate)
PUBLIC_HOST=comfy.example.com
# cloudflared tunnel hostname that lands on ComfyUI :8188 inside Colab
COLAB_TUNNEL_HOST=comfy-colab.example.com

# ───────────────────────── Cloudflare Access ─────────────────────────
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# "Application Audience (AUD) Tag" of the PUBLIC_HOST Access app
CF_ACCESS_AUD=
# second check after Access (comma separated)
ALLOWED_EMAILS=you@example.com
# owners; empty = every signed-in user is an owner
OWNER_EMAILS=you@example.com
# any of wake,switch,stop,extend
OWNER_ONLY_ACTIONS=switch,stop,extend
# {"client_id": "...", "client_secret": "..."} for COLAB_TUNNEL_HOST
CF_SERVICE_TOKEN_FILE=/run/secrets/cf_service.json
# AUTH_DISABLED=false                       # true ONLY for local development without Cloudflare

# ─────────────────────────────── Colab ───────────────────────────────
COLAB_BIN=colab
# colab CLI OAuth state (written once by `colab` login inside the container)
COLAB_TOKEN_DIR=/data/colab-cli
COLAB_ACCELERATOR=L4
COLAB_SESSION_NAME=comfy

# ────────────────────────────── Profiles ─────────────────────────────
PROFILES=profiles/examples/moss-image,profiles/examples/sd-latest,profiles/examples/qwen-image
DEFAULT_PROFILE=moss-image
# app | graph — what ComfyUI opens in once ready
DEFAULT_VIEW=app

# ─────────────── Secrets forwarded to Colab (kernel memory only) ───────────────
CF_TUNNEL_TOKEN_FILE=/run/secrets/colab_tunnel_token
# optional read-only HF token (gated repos / rate limits)
HF_TOKEN_FILE=

# ───────────────────────────── Cold start ────────────────────────────
# start ComfyUI once core models are in, keep downloading the rest
FAST_START=true
DOWNLOAD_CONCURRENCY=8
# Xet high-performance mode for HF downloads (more parallel connections)
XET_HIGH_PERFORMANCE=true
# uv | pip for ComfyUI requirements
PIP_INSTALLER=uv

# ───────────────────────────── Auto-stop ─────────────────────────────
# true = opening the page wakes it (HF Space behaviour)
WAKE_ON_VISIT=false
# no HTTP/ws activity and empty queue → sleep (0 = off)
IDLE_TIMEOUT_MIN=30
MAX_SESSION_HOURS=6
EXTEND_MAX_TIMES=1
EXTEND_HOURS=1
WARN_BEFORE_MIN=10
BOOT_TIMEOUT_MIN=40
# all tabs closed for N min → sleep (0 = off)
STOP_ON_PAGE_CLOSE_MIN=0
# e.g. 01:00-08:00 (no wake; running sessions stop)
QUIET_HOURS=
DAILY_CU_BUDGET=12
MONTHLY_CU_BUDGET=150
MIN_CU_BALANCE=5
# L4 estimate used for the local ledger
CU_PER_HOUR=1.71
ORPHAN_SWEEP_MIN=5
# Colab side: no gate heartbeat for N min → VM releases itself
WATCHDOG_GATE_LOST_MIN=20

# ─────────────────────────── Agents & runtime ────────────────────────
# `openssl rand -hex 32 > secrets/agent_token`
AGENT_TOKEN_FILE=/run/secrets/agent_token
LISTEN_ADDR=0.0.0.0:8080
STATE_DIR=/data/state
LOG_LEVEL=info
TZ=Asia/Shanghai

# ───────────────────────────── Landing Site (CF Pages) ─────────────────────────────
# Cloudflare Pages project name and optional custom domain for apps/site
SITE_PAGES_PROJECT=comfy-colab-kit
SITE_CUSTOM_DOMAIN=
