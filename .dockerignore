# Never include secrets, local state, or custom profiles in Docker build context
.env
.env.*
!.env.example
secrets/
data/
profiles/custom/*
!profiles/custom/.gitkeep
!profiles/custom/README.md
*.token
*.pem
*.key
token.json
cf_service*.json

# Build, test & dev artifacts
.git/
.github/
.venv/
.pytest_cache/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
node_modules/
outputs/
*.safetensors
*.ckpt
*.gguf
.DS_Store
.deploy-notes.md
.handoff.md
.wrangler/
grok/
scratch/
drafts/
screenshots/
assets/
apps/site/
